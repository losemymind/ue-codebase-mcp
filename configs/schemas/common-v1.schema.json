{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ue-codebase-mcp.invalid/common/v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "secretCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_ref"
      ],
      "properties": {
        "secret_ref": {
          "type": "string",
          "pattern": "^secret://[a-z][a-z0-9._-]{1,62}/[A-Za-z0-9][A-Za-z0-9._/-]{0,253}$"
        }
      }
    },
    "resourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_memory_mb",
        "max_cpu_percent"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 512,
          "maximum": 262144
        },
        "max_cpu_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
