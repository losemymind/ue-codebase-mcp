{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ue-codebase-mcp.invalid/project/v1",
  "title": "UE Codebase MCP project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "slug",
    "name",
    "ue_version",
    "status",
    "repository_ids"
  ],
  "properties": {
    "schema": {
      "const": "ue-codebase-mcp/project"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "common-v1.schema.json#/$defs/identifier"
    },
    "slug": {
      "$ref": "common-v1.schema.json#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ue_version": {
      "const": "5.6"
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ]
    },
    "repository_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "common-v1.schema.json#/$defs/identifier"
      }
    }
  }
}
