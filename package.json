{
  "name": "ue-codebase-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Production foundation for a read-only UE 5.6 codebase MCP indexer.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "clean": "node tools/clean.mjs",
    "compile-db:audit": "node tools/audit-compile-database.mjs",
    "control-plane:db:test:live": "node tools/verify-control-plane-postgres.mjs",
    "ci": "npm run format:check && npm run lint && npm run governance:check && npm test && npm run build && npm run license:check && npm run sbom",
    "db:migrate": "powershell -NoProfile -File database/migrate.ps1 -Action up",
    "db:rollback": "powershell -NoProfile -File database/migrate.ps1 -Action down",
    "db:test:live": "powershell -NoProfile -File database/test-migrations.ps1",
    "env:db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/live-database/manage-environment.ps1 -Action Backup",
    "env:db:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/live-database/manage-environment.ps1 -Action Install",
    "env:db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/live-database/manage-environment.ps1 -Action Status",
    "env:db:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/live-database/manage-environment.ps1 -Action Uninstall",
    "env:db:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/live-database/manage-environment.ps1 -Action Verify",
    "format:check": "node tools/quality.mjs format",
    "governance:check": "node tools/validate-ownership.mjs docs/governance/ownership.json && node tools/sync-codeowners.mjs --check",
    "governance:sync": "node tools/sync-codeowners.mjs --write && npm run governance:check",
    "lint": "node tools/quality.mjs lint",
    "license:check": "node tools/license-audit/check.mjs",
    "native:package": "node tools/package-clang-runtime.mjs",
    "native:benchmark": "node tools/benchmark-clang-cursor-sample.mjs",
    "release:check": "node tools/release/check.mjs",
    "sbom": "node tools/sbom/generate.mjs",
    "test": "node --test --test-reporter=spec"
  }
}
